# Copy this file to ".env" in the same folder and fill in real values.
# ".env" is git-ignored; never commit it.

# JDBC URL of the MySQL database (create the empty schema first)
DB_URL=jdbc:mysql://localhost:3306/gatekeeper_manager

# MySQL user and password
DB_USERNAME=root
DB_PASSWORD=change-me

# HMAC key used to sign and verify JWTs (HS256). Use at least 32 random characters.
# Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
